<Window x:Class="AuralDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AuralDesk" Height="720" Width="1120"
        Icon="app.ico"
        MinHeight="600" MinWidth="960"
        Background="{StaticResource BgWindowBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" KeyDown="Window_KeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}"
                BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False" Margin="16,24,16,16">

                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Image Width="64" Height="64" Source="pack://application:,,,/app_icon.png"
                           Stretch="Uniform" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AURALDESK" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="HI-FI STREAMING" FontSize="9.5" Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Nav -->
                <StackPanel DockPanel.Dock="Top" Margin="0,28,0,0">
                    <Button x:Name="NavQueue" Tag="queue" Click="Nav_Click"
                            Style="{StaticResource NavButtonStyle}" Content="播放队列"/>
                    <Button x:Name="NavStream" Tag="stream" Click="Nav_Click"
                            Style="{StaticResource NavButtonStyle}" Content="流媒体"/>
                    <Button x:Name="NavSettings" Tag="settings" Click="Nav_Click"
                            Style="{StaticResource NavButtonStyle}" Content="设置"/>
                </StackPanel>

                <!-- HQPlayer status card -->
                <Border DockPanel.Dock="Bottom" CornerRadius="10" Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HqStatusDot" Width="8" Height="8" Fill="{StaticResource TextDimBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="HQPlayer" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="HqStatusText" Text="未连接" FontSize="10.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- System stats (toggleable in Settings) -->
                <Border x:Name="SystemStatsCard" DockPanel.Dock="Bottom" Visibility="Collapsed"
                        CornerRadius="10" Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" Padding="12,10"
                        Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="系统资源" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Grid x:Name="MemRow" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="内存" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="MemValue" Grid.Column="1" FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                        <Grid x:Name="CpuRow" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="CpuValue" Grid.Column="1" FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" Text="v0.1.0 · 界面原型" FontSize="9.5"
                           Foreground="{StaticResource TextDimBrush}" Margin="2,12,0,0"/>
            </DockPanel>
        </Border>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Padding="20,12" BorderBrush="{StaticResource BorderCardBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ViewTitle" Text="播放队列" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="来源" FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="SourceCombo" Width="116" Style="{StaticResource ComboStyle}"
                                      SelectionChanged="SourceCombo_SelectionChanged">
                                <ComboBoxItem Content="播放队列" Tag="queue"/>
                                <ComboBoxItem Content="QQ音乐" Tag="https://y.qq.com" IsSelected="True"/>
                                <ComboBoxItem Content="网易云音乐" Tag="https://music.163.com" IsEnabled="False"/>
                                <ComboBoxItem Content="Apple Music" Tag="https://music.apple.com/cn/browse" IsEnabled="False"/>
                                <ComboBoxItem Content="自定义 URL" Tag="custom"/>
                            </ComboBox>
                            <TextBlock Text="输出" FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center" Margin="16,0,6,0"/>
                            <ComboBox x:Name="OutputCombo" Width="130" Style="{StaticResource ComboStyle}"
                                      SelectionChanged="OutputCombo_SelectionChanged">
                                <ComboBoxItem Content="系统输出" IsSelected="True"/>
                                <ComboBoxItem Content="NAA（HQPlayer）"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="输出与升频配置请在 HQPlayer 中调整" FontSize="9"
                                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Queue view ===================== -->
            <Grid x:Name="QueuePanel" Grid.Row="1" Margin="20,16,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工具条 -->
                <Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="播放队列" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Width="1" Height="18" Background="{StaticResource BorderCardBrush}"
                                Margin="14,0" VerticalAlignment="Center"/>
                        <Button x:Name="QueueUpBtn" Content="上移" Style="{StaticResource TogglePillStyle}"
                                Click="QueueUp_Click" Margin="0,0,8,0"/>
                        <Button x:Name="QueueDownBtn" Content="下移" Style="{StaticResource TogglePillStyle}"
                                Click="QueueDown_Click" Margin="0,0,8,0"/>
                        <Button x:Name="QueueDeleteBtn" Content="删除选中" Style="{StaticResource TogglePillStyle}"
                                Click="QueueDelete_Click"/>
                        <Border Width="1" Height="18" Background="{StaticResource BorderCardBrush}"
                                Margin="14,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="QueueSelectAll" Content="全选" Style="{StaticResource CheckStyle}"
                                  VerticalAlignment="Center" Click="QueueSelectAll_Click"/>
                        <TextBlock x:Name="QueueEmptyHint" Text="（空）" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <CheckBox x:Name="QueueSelectModeBtn" Content="选择模式" Style="{StaticResource CheckStyle}"
                                  VerticalAlignment="Center" Margin="14,0,0,0"
                                  Checked="QueueSelectMode_Changed" Unchecked="QueueSelectMode_Changed"/>
                    </StackPanel>
                </Border>

                <!-- 列表 -->
                <ListBox x:Name="QueueList" Grid.Row="1" Margin="0,12,0,0" ScrollViewer.ScrollChanged="QueueScroll_Changed" SelectionMode="Extended" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                                                Margin="2,0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource AccentDimBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource QqRowCompactStyle}" Margin="6,0,6,6"
                                    Click="QueueTrack_Click" Tag="{Binding}">
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 正在播放指示：左侧蓝色小条（不贴边） -->
                                    <Border Grid.Column="0" Width="3" Height="18" CornerRadius="1.5"
                                            Background="{StaticResource AccentBrush}"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Margin="0,0,5,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8"
                                            Background="{StaticResource FillBrush}"
                                            VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="&#x266B;" FontFamily="Segoe UI Symbol" FontSize="15"
                                                       Foreground="{StaticResource TextDimBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding CoverUrl}" Width="40" Height="40"
                                                   Stretch="UniformToFill" ImageFailed="QqCover_ImageFailed">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,40,40" RadiusX="8" RadiusY="8"/>
                                                </Image.Clip>
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CoverUrl}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CacheState}" FontSize="10" Foreground="#E67E22"
                                                       VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CacheState}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Singer}" FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center"
                                                HorizontalAlignment="Right">
                                        <Path Width="16" Height="16" Cursor="Hand" Margin="0,0,0,3"
                                              Data="M12,21.35l-1.45,-1.32C5.4,15.36 2,12.28 2,8.5 2,5.42 4.42,3 7.5,3c1.74,0 3.41,0.81 4.5,2.09C13.09,3.81 14.76,3 16.5,3 19.58,3 22,5.42 22,8.5c0,3.78 -3.4,6.86 -8.55,11.54L12,21.35z"
                                              Stretch="Uniform" HorizontalAlignment="Right"
                                              Tag="{Binding}" ToolTip="收藏 / 取消收藏"
                                              PreviewMouseLeftButtonDown="QueueFav_PreviewDown"
                                              MouseLeftButtonUp="QueueFav_MouseUp">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="Transparent"/>
                                                    <Setter Property="Stroke" Value="#FFB9B9C0"/>
                                                    <Setter Property="StrokeThickness" Value="1.6"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding QqMid}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFav}" Value="True">
                                                            <Setter Property="Fill" Value="#FFE0245E"/>
                                                            <Setter Property="Stroke" Value="#FFE0245E"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Source}" Style="{StaticResource BadgeTextStyle}"/>
                                        </Border>
                                        <TextBlock Text="正在播放" FontSize="10"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Right" Margin="0,3,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                    <Button x:Name="QueueJumpCurrentBtn" Grid.Row="1"
                            Content="&#xE8A1;" ToolTip="返回当前播放歌曲"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,14"
                            Opacity="0" Visibility="Collapsed" Click="QueueJumpCurrent_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Width" Value="38"/>
                                <Setter Property="Height" Value="38"/>
                                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border x:Name="bd" CornerRadius="19" Background="{TemplateBinding Background}"/>
                                                <Border x:Name="shade" CornerRadius="19" Background="#11000000" Opacity="0"/>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="shade" Property="Opacity" Value="0.25"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="shade" Property="Opacity" Value="0.45"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
            </Grid>
            <Grid x:Name="StreamPanel" Grid.Row="1" Visibility="Collapsed" Margin="20,14,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox" Text="https://y.qq.com" Style="{StaticResource TextBoxStyle}"
                             KeyDown="UrlBox_KeyDown"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="打开" Style="{StaticResource TogglePillStyle}" Click="UrlOpen_Click"/>
                        <Button Content="&#xE72C;" Style="{StaticResource IconButtonStyle}" Click="UrlBack_Click"
                                ToolTip="后退"/>
                        <Button Content="&#xE72A;" Style="{StaticResource IconButtonStyle}" Click="UrlForward_Click"
                                ToolTip="前进"/>
                        <Button Content="&#xE72C;" Style="{StaticResource IconButtonStyle}" Click="UrlRefresh_Click"
                                ToolTip="刷新" RenderTransformOrigin="0.5,0.5">
                            <Button.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Button.RenderTransform>
                        </Button>
                        <ComboBox x:Name="QqQualityCombo" Width="120" Margin="8,0,0,0"
                                  VerticalAlignment="Center" SelectedIndex="2"
                                  SelectionChanged="QqQualityCombo_Changed">
                            <ComboBoxItem Content="m4a 试听"/>
                            <ComboBoxItem Content="MP3 128k"/>
                            <ComboBoxItem Content="MP3 320k"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="12" Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" ClipToBounds="True">
                    <wv2:WebView2 x:Name="Browser"/>
                </Border>
            </Grid>

            <!-- ===================== QQ 音乐 view ===================== -->
            <Grid x:Name="QqPanel" Grid.Row="1" Visibility="Collapsed" Margin="20,14,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 状态行 -->
                <Border CornerRadius="12" Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="QqStatusDot" Width="10" Height="10"
                                     Fill="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="QqStatusText" Margin="8,0,0,0" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" Text="QQ 音乐组件未启动"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="QqApiQualityCombo" Width="130" Margin="0,0,8,0"
                                      VerticalAlignment="Center" Style="{StaticResource ComboStyle}" SelectedIndex="0"
                                      SelectionChanged="QqQualityCombo_Changed">
                                <ComboBoxItem Content="Hi-Res"/>
                                <ComboBoxItem Content="无损"/>
                                <ComboBoxItem Content="普通"/>
                            </ComboBox>
                            <Button x:Name="QqLoginBtn" Content="扫码登录" Style="{StaticResource TogglePillStyle}"
                                    Click="QqLogin_Click"/>
                            <Button x:Name="QqLogoutBtn" Content="退出登录" Style="{StaticResource TogglePillStyle}"
                                    Click="QqLogout_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
                            <Button x:Name="QqRefreshBtn" Content="刷新" Style="{StaticResource TogglePillStyle}"
                                    Click="QqRefresh_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tab 行 -->
                <DockPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button x:Name="QqOnlineSearchBtn" DockPanel.Dock="Right" Content="&#xE721;"
                            FontFamily="Segoe MDL2 Assets" FontSize="13" Style="{StaticResource TogglePillStyle}"
                            Click="QqOnlineSearch_Click" ToolTip="在线搜索（单曲/专辑/歌手）" Margin="8,0,0,0"/>
                    <Button x:Name="QqUrlBtn" DockPanel.Dock="Right" Content="&#xE71B;"
                            FontFamily="Segoe MDL2 Assets" FontSize="13" Style="{StaticResource TogglePillStyle}"
                            Click="QqUrl_Click" ToolTip="打开链接" Margin="8,0,0,0"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="QqBackBtn" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                Style="{StaticResource TogglePillStyle}"
                                Click="QqBackBtn_Click" ToolTip="返回"/>
                        <Button x:Name="QqHomeBtn" Content="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                Style="{StaticResource TogglePillStyle}"
                                Click="QqHome_Click" ToolTip="返回主页"/>
                        <Button x:Name="QqBackToPlaylists" Content="← 返回歌单" Style="{StaticResource TogglePillStyle}"
                                Click="QqBackToPlaylists_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="QqListTitle" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" Text=""/>
                        <TextBlock x:Name="QqListCountText" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource TextDimBrush}" Text=""/>
                        <Button x:Name="RandomPlayBtn" Content="随机播放" Style="{StaticResource TogglePillStyle}"
                                VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"
                                Click="RandomPlay_Click"/>
                        <ComboBox x:Name="QqSortCombo" Width="108" Margin="10,0,0,0"
                                  Style="{StaticResource ComboStyle}" VerticalAlignment="Center"
                                  SelectionChanged="QqSort_Changed">
                            <ComboBoxItem Content="默认排序" Tag="default" IsSelected="True"/>
                            <ComboBoxItem Content="歌名" Tag="title"/>
                            <ComboBoxItem Content="歌手" Tag="singer"/>
                            <ComboBoxItem Content="时长" Tag="duration"/>
                            <ComboBoxItem Content="专辑" Tag="album"/>
                        </ComboBox>
                    </StackPanel>
                </DockPanel>

                <!-- 内容区 -->
                <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="12" Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 搜索行 -->
                        <Grid x:Name="QqSearchRow" Visibility="Collapsed" Margin="12,12,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="QqSearchBox" Style="{StaticResource TextBoxStyle}"
                                     KeyDown="QqSearchBox_KeyDown"/>
                            <Button Grid.Column="1" Content="搜索" Style="{StaticResource TogglePillStyle}"
                                    Click="QqSearchBtn_Click" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- 歌单列表 -->
                        <!-- 主页推荐卡片 -->
                        <ScrollViewer x:Name="QqHomeScroller" Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto" Margin="12,12,12,0">
                            <ItemsControl x:Name="QqHomeList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource QqRowButtonStyle}" Margin="0,0,0,10"
                                                Click="QqHomeCard_Click" Tag="{Binding}">
                                            <Grid Margin="14,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="42" Height="42" CornerRadius="10"
                                                        Background="{StaticResource AccentDimBrush}">
