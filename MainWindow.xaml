                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource QqRowButtonStyle}" Margin="0,0,0,4"
                                                            Click="QqSearchSong_Click" Tag="{Binding}">
                                                        <Grid Margin="10,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding Singer}" FontSize="11"
                                                                           Foreground="{StaticResource TextDimBrush}"
                                                                           Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Duration}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextDimBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl x:Name="QqSearchAlbumList" Visibility="Collapsed">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource QqRowButtonStyle}" Margin="0,0,0,4"
                                                            Click="QqSearchAlbum_Click" Tag="{Binding}">
                                                        <Grid Margin="10,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="42"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="36" Height="36" CornerRadius="6"
                                                                    Background="{StaticResource FillBrush}"
                                                                    VerticalAlignment="Center">
                                                                <Grid>
                                                                    <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="13"
                                                                               Foreground="{StaticResource TextDimBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                    <Image Source="{Binding CoverUrl}" Width="36" Height="36"
                                                                           Stretch="UniformToFill"
                                                                           ImageFailed="QqCover_ImageFailed">
                                                                        <Image.Clip>
                                                                            <RectangleGeometry Rect="0,0,36,36" RadiusX="6" RadiusY="6"/>
                                                                        </Image.Clip>
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding CoverUrl}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                    <TextBlock Text="{Binding Singer}" FontSize="11"
                                                                               Foreground="{StaticResource TextDimBrush}"/>
                                                                    <TextBlock Text="{Binding Date}" FontSize="11"
                                                                               Foreground="{StaticResource TextDimBrush}"
                                                                               Margin="8,0,0,0"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <Path Width="18" Height="18" Cursor="Hand" Margin="0,0,10,0"
                                                                      Data="M12,21.35l-1.45,-1.32C5.4,15.36 2,12.28 2,8.5 2,5.42 4.42,3 7.5,3c1.74,0 3.41,0.81 4.5,2.09C13.09,3.81 14.76,3 16.5,3 19.58,3 22,5.42 22,8.5c0,3.78 -3.4,6.86 -8.55,11.54L12,21.35z"
                                                                      Stretch="Uniform" Tag="{Binding}"
                                                                      ToolTip="收藏 / 取消收藏专辑"
                                                                      PreviewMouseLeftButtonDown="QqAlbumFav_PreviewDown"
                                                                      MouseLeftButtonUp="QqAlbumFav_MouseUp">
                                                                    <Path.Style>
                                                                        <Style TargetType="Path">
                                                                            <Setter Property="Fill" Value="Transparent"/>
                                                                            <Setter Property="Stroke" Value="#FFB9B9C0"/>
                                                                            <Setter Property="StrokeThickness" Value="1.6"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsFav}" Value="True">
                                                                                    <Setter Property="Fill" Value="#FFE0245E"/>
                                                                                    <Setter Property="Stroke" Value="#FFE0245E"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Path.Style>
                                                                </Path>
                                                                <TextBlock Text="&#xE76C;" FontSize="12"
                                                                           Foreground="{StaticResource TextDimBrush}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl x:Name="QqSearchSingerList" Visibility="Collapsed">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource QqRowButtonStyle}" Margin="0,0,0,4"
                                                            Click="QqSearchSinger_Click" Tag="{Binding}">
                                                        <Grid Margin="10,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="42"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="36" Height="36" CornerRadius="18"
                                                                    Background="{StaticResource FillBrush}"
                                                                    VerticalAlignment="Center">
                                                                <Grid>
                                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="14"
                                                                               Foreground="{StaticResource TextDimBrush}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                    <Image Source="{Binding Pic}" Width="36" Height="36"
                                                                           Stretch="UniformToFill"
                                                                           ImageFailed="QqCover_ImageFailed">
                                                                        <Image.Clip>
                                                                            <EllipseGeometry RadiusX="18" RadiusY="18"
                                                                                             Center="18,18"/>
                                                                        </Image.Clip>
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Pic}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" FontSize="11"
                                                                       Foreground="{StaticResource TextDimBrush}"
                                                                       VerticalAlignment="Center">
                                                                <Run Text="{Binding SongNum, StringFormat={}{0} 首}"/>
                                                                <Run Text=" · "/>
                                                                <Run Text="{Binding AlbumNum, StringFormat={}{0} 张专辑}"/>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Border>

                <Border x:Name="QrOverlay" Grid.Row="0" Grid.RowSpan="3" CornerRadius="12"
                        Background="#F2FFFFFF" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="QrTitleText" Text="QQ 扫码登录" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <RadioButton x:Name="QrTypeQQ" Content="QQ 登录" GroupName="QrType" IsChecked="True"
                                          Checked="QrType_Changed" Style="{StaticResource RadioStyle}"/>
                            <RadioButton x:Name="QrTypeWx" Content="微信登录" GroupName="QrType"
                                          Checked="QrType_Changed" Style="{StaticResource RadioStyle}" Margin="16,0,0,0"/>
                        </StackPanel>
                        <Border Width="220" Height="220" Margin="0,14,0,0" CornerRadius="10" Background="White"
                                BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1">
                            <Image x:Name="QrImage" Stretch="Uniform" Margin="10"/>
                        </Border>
                        <TextBlock x:Name="QrStatusText" Text="等待扫码…" FontSize="13" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Content="取消" Style="{StaticResource TogglePillStyle}" Click="QrCancel_Click"
                                Margin="0,14,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===================== Settings view ===================== -->
            <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="20,16,20,20">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <!-- Resume last song -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="启动恢复" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="启动软件时是否恢复上一次播放的歌曲（可包含进度）。"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <StackPanel Margin="0,12,0,0">
                                <RadioButton x:Name="ResumeOff" Content="不恢复"
                                             Checked="ResumeMode_Changed" Style="{StaticResource RadioStyle}"/>
                                <RadioButton x:Name="ResumeSong" Content="仅恢复歌曲（从头播放）"
                                             Checked="ResumeMode_Changed" Style="{StaticResource RadioStyle}"/>
                                <RadioButton x:Name="ResumeFull" Content="恢复歌曲和进度"
                                             IsChecked="True" Checked="ResumeMode_Changed" Style="{StaticResource RadioStyle}"/>
                            </StackPanel>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="歌词偏移" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="LyricOffsetBox" Grid.Column="1" Text="400"
                                         TextChanged="LyricOffset_Changed" Style="{StaticResource TextBoxStyle}"/>
                                <TextBlock Grid.Column="2" Text="毫秒（正=延后，负=提前）" FontSize="10.5"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Margin="0,14,0,0"
                                      Style="{StaticResource CheckStyle}" Checked="AutoStart_Changed"
                                      Unchecked="AutoStart_Changed"/>
                        </StackPanel>
                    </Border>
                    <!-- Buffer -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="缓冲区" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="下一首与最近播放歌曲的总大小上限，超出上限自动删除最早的一首。"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,14,0,0">
                                <RadioButton x:Name="Buf256" Content="256 MB" Checked="BufferOption_Changed" Style="{StaticResource RadioStyle}"/>
                                <RadioButton x:Name="Buf512" Content="512 MB" IsChecked="True" Checked="BufferOption_Changed" Style="{StaticResource RadioStyle}"/>
                                <RadioButton x:Name="Buf1G" Content="1 GB" Checked="BufferOption_Changed" Style="{StaticResource RadioStyle}"/>
                                <RadioButton x:Name="BufCustom" Content="自定义" Checked="BufferOption_Changed" Style="{StaticResource RadioStyle}"/>
                                <TextBox x:Name="BufCustomValue" Width="90" TextChanged="BufCustom_Changed"
                                         Style="{StaticResource TextBoxStyle}" Margin="8,0,0,0"/>
                                <TextBlock Text="MB" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <RadioButton x:Name="BufCount" Content="按曲数" Checked="BufferOption_Changed" Style="{StaticResource RadioStyle}" Margin="16,0,0,0"/>
                                <TextBox x:Name="BufCountValue" Width="60" TextChanged="BufCount_Changed"
                                         Style="{StaticResource TextBoxStyle}" Margin="8,0,0,0"/>
                                <TextBlock Text="首" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </WrapPanel>
                                                        <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="提前缓存" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="PreCacheBox" Grid.Column="1" Width="48" Text="2"
                                         TextChanged="PreCache_Changed" Style="{StaticResource TextBoxStyle}"/>
                                <TextBlock Grid.Column="2" Text="首下一首（连续切歌更顺）" FontSize="10.5"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
<Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="缓存路径" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="CachePathBox" Grid.Column="1"
                                         TextChanged="CachePath_Changed" Style="{StaticResource TextBoxStyle}"/>
                                <Button Grid.Column="2" Content="浏览…" Style="{StaticResource TogglePillStyle}"
                                        Click="CachePathBrowse_Click" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- HQPlayer -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="HQPlayer 连接" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Button x:Name="HqToggle" Grid.Column="1" Content="升频：开"
                                        Style="{StaticResource TogglePillStyle}" Click="HqToggle_Click"/>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="地址" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="HqAddressBox" Grid.Column="1" Text="127.0.0.1"
                                         TextChanged="HqFields_Changed" Style="{StaticResource TextBoxStyle}"/>
                                <TextBlock Grid.Column="2" Text="端口" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="14,0,8,0"/>
                                <TextBox x:Name="HqPortBox" Grid.Column="3" Text="4321"
                                         TextChanged="HqFields_Changed" Style="{StaticResource TextBoxStyle}"/>
                            </Grid>
                            <CheckBox x:Name="HqAutoStartCheck" Content="启动软件时自动启动 HQPlayer" FontSize="11"
                                      Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"
                                      Style="{StaticResource CheckStyle}" Checked="HqAutoStart_Changed"
                                      Unchecked="HqAutoStart_Changed"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="HQPlayer 路径" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="HqExePathBox" Grid.Column="1"
                                         TextChanged="HqExePath_Changed" Style="{StaticResource TextBoxStyle}"/>
                                <Button Grid.Column="2" Content="自动定位" Margin="8,0,0,0"
                                        Style="{StaticResource TogglePillStyle}" Click="HqLocate_Click"/>
                                <Button Grid.Column="3" Content="浏览…" Margin="8,0,0,0"
                                        Style="{StaticResource TogglePillStyle}" Click="HqExeBrowse_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- System info -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="系统信息" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="在侧栏底部显示本机资源占用（应用自身）。"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <StackPanel Margin="0,12,0,0">
                                <CheckBox x:Name="ShowMemCheck" Content="显示内存占用"
                                          Style="{StaticResource CheckStyle}" Checked="StatsCheck_Changed"
                                          Unchecked="StatsCheck_Changed"/>
                                <CheckBox x:Name="ShowCpuCheck" Content="显示 CPU 占用"
                                          Style="{StaticResource CheckStyle}" Checked="StatsCheck_Changed"
                                          Unchecked="StatsCheck_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 局域网遥控 -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="局域网遥控" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <CheckBox x:Name="RemoteCtrlCheck" Grid.Column="1" Content="启用"
                                          Style="{StaticResource CheckStyle}" Checked="RemoteCtrl_Changed"
                                          Unchecked="RemoteCtrl_Changed"/>
                            </Grid>
                            <TextBlock Margin="0,6,0,0" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       Text="开启后手机连接同一 WiFi，访问下方地址即可遥控（播放/切歌/进度/歌词/队列）。"/>
                            <TextBlock x:Name="RemoteCtrlAddress" Margin="0,10,0,0" FontSize="13"
                                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                       Text="未开启" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ===================== Now playing ===================== -->
            <!-- 全局「返回当前播放歌曲」按钮：首页/歌单列表/设置等任意视图下可用 -->
            <Button x:Name="GlobalJumpBtn" Grid.Row="1"
                    Content="&#xE8A1;" ToolTip="返回当前播放歌曲"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,14"
                    Opacity="0" Visibility="Collapsed" Click="GlobalJumpCurrent_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Width" Value="38"/>
                        <Setter Property="Height" Value="38"/>
                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="bd" CornerRadius="19" Background="{TemplateBinding Background}"/>
                                        <Border x:Name="shade" CornerRadius="19" Background="#11000000" Opacity="0"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="shade" Property="Opacity" Value="0.25"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="shade" Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
            <Border Grid.Row="2" Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="0,1,0,0"
                    Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- Track info -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CoverBtn" Style="{StaticResource CoverButtonStyle}"
                                Click="OpenNowPlaying_Click" ToolTip="展开正在播放">
                            <Grid>
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="BottomTitleText" Text="未在播放" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="BottomSingerText" Text="" FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            <TextBlock x:Name="BottomSourceText" Text="" FontSize="9"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Controls + progress -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="PrevBtn" Style="{StaticResource IconButtonStyle}" Content="&#xE892;"
                                    Click="Prev_Click"/>
                            <Button x:Name="PlayBtn" Style="{StaticResource PlayButtonStyle}" Content="&#xE769;"
                                    Click="Play_Click" Margin="14,0"/>
                            <Button x:Name="NextBtn" Style="{StaticResource IconButtonStyle}" Content="&#xE893;"
                                    Click="Next_Click"/>
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BottomPosText" Text="0:00" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                       VerticalAlignment="Center"/>
                            <Grid Grid.Column="1" Height="16" VerticalAlignment="Center" Margin="10,0">
                                <Border x:Name="BottomProgressTrack" Height="3" CornerRadius="1.5"
                                        Background="{StaticResource BorderCardBrush}" VerticalAlignment="Center">
                                    <Border x:Name="BottomProgressFill" Width="96" Height="3" CornerRadius="1.5"
                                            HorizontalAlignment="Left"
                                            Background="{StaticResource AccentBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="BottomDurText" Grid.Column="2" Text="0:00" FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- 状态日志 + HQ（日志宽度自适应，NAA 芯片仅在 NAA 输出时显示） -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center" Margin="0,0,14,0" Text="就绪"
                                   TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="1" Style="{StaticResource ChipStyle}" Visibility="Collapsed">
                            <TextBlock x:Name="NaaStatusText" Text="NAA · 未连接" Style="{StaticResource ChipTextStyle}"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Now Playing overlay ===================== -->
        <Grid x:Name="NowPlayingOverlay" Grid.ColumnSpan="2" Background="{StaticResource BgWindowBrush}"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <TranslateTransform/>
            </Grid.RenderTransform>
            <Grid Margin="48,28,48,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="&#xE70D;" Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Click="CloseNowPlaying_Click" ToolTip="收起"/>
<Button x:Name="FullScreenBtn" Content="&#xE740;" Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="FullScreen_Click" ToolTip="全屏"/>

                <!-- 左：封面 + 进度 + 控制 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="300" Height="300">
                        <Border CornerRadius="20" Background="#40000000" Margin="0,10,0,0">
                            <Border.Effect>
                                <BlurEffect Radius="12"/>
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="20" Background="{StaticResource CoverBrush}">
                            <Grid>
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="90"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="OverlayCoverImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="OverlayTitleText" Text="未在播放" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,24,0,0"/>
                    <TextBlock x:Name="OverlaySingerText" Text="" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock x:Name="OverlaySourceText" Text="" FontSize="11"
                               Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>

                    <Grid Width="360" Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OverlayPosText" Text="0:00" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Height="16" VerticalAlignment="Center" Margin="10,0">
                            <Border x:Name="OverlayProgressTrack" Height="4" CornerRadius="2"
                                    Background="{StaticResource BorderCardBrush}" VerticalAlignment="Center">
                                <Border x:Name="OverlayProgressFill" Width="150" Height="4" CornerRadius="2"
                                        HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="OverlayDurText" Grid.Column="2" Text="0:00" FontSize="10"
                                   Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button x:Name="OverlayPrevBtn" Style="{StaticResource IconButtonStyle}" Content="&#xE892;" Click="Prev_Click"/>
                        <Button x:Name="OverlayPlayBtn" Style="{StaticResource PlayButtonStyle}" Content="&#xE769;"
                                Margin="18,0" Click="OverlayPlay_Click"/>
                        <Button x:Name="OverlayNextBtn" Style="{StaticResource IconButtonStyle}" Content="&#xE893;" Click="Next_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右：歌词（全部靠左贴边） -->
                <Grid Grid.Column="1" Margin="48,0,0,0">
                    <ScrollViewer x:Name="LyricScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <Grid MinHeight="{Binding ActualHeight, ElementName=LyricScroller}">
                            <StackPanel x:Name="LyricList" Margin="0,8,0,8" VerticalAlignment="Center">
                            <TextBlock Text="[Verse 1]" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Left"/>
                            <TextBlock Text="Fever dream high in the quiet of the night" FontSize="15"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"
                                       Margin="0,14,0,0"/>
                            <TextBlock Text="在安静的夜里，做着发烧般的梦" FontSize="15"
                                       Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Left"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="You know that I caught it" FontSize="15"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"
                                       Margin="0,14,0,0"/>
                            <TextBlock Text="你知道我已深陷其中" FontSize="15"
                                       Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Left"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="Bad, bad boy, shiny toy with a price" FontSize="15"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"
                                       Margin="0,14,0,0"/>
                            <TextBlock Text="坏坏的男孩，带着价格的光鲜玩具" FontSize="15"
                                       Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Left"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="[Chorus]" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                       HorizontalAlignment="Left" Margin="0,24,0,0"/>
                            <TextBlock Text="&#x2019;Cause it&#x2019;s a cruel summer" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                       Margin="0,14,0,0"/>
                            <TextBlock Text="因为这是一个残酷的夏天" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Left"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="It&#x2019;s cool, that&#x2019;s what I tell &#x2019;em" FontSize="15"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"
                                       Margin="0,14,0,0"/>
                            <TextBlock Text="这很酷，我这样告诉他们" FontSize="15"
                                       Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Left"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="No rules in breakable heaven" FontSize="15"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"
                                       Margin="0,14,0,0"/>
                            <TextBlock Text="在这易碎的天堂里没有规则" FontSize="15"
                                       Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Left"
                                       Margin="0,4,0,0"/>
                            <TextBlock Text="But, ooh, whoa, oh" FontSize="15"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"
                                       Margin="0,14,0,0"/>
                            <TextBlock Text="It&#x2019;s a cruel summer" FontSize="15"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left"
                                       Margin="0,14,0,0"/>
                                                    </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <Border IsHitTestVisible="False" VerticalAlignment="Top" Height="64">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFF7F7F8" Offset="0"/>
                                <GradientStop Color="#00F7F7F8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border IsHitTestVisible="False" VerticalAlignment="Bottom" Height="64">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00F7F7F8" Offset="0"/>
                                <GradientStop Color="#FFF7F7F8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
