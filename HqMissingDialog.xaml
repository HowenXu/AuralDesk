<Window x:Class="AuralDesk.HqMissingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource hqMissingTitle}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="Segoe UI" UseLayoutRounding="True">
    <Border Margin="16" CornerRadius="14" Background="{StaticResource BgCardBrush}"
            BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
            Padding="24,20">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Width="40" Height="40" Source="pack://application:,,,/app_icon.png"
                       Stretch="Uniform" VerticalAlignment="Center"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource hqMissingTitle}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource hqMissingSub}" FontSize="11"
                               Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="0,16,0,0" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap" LineHeight="20"
                       Text="{DynamicResource hqMissingBody}"/>
            <TextBlock Margin="0,8,0,0" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap"
                       Text="{DynamicResource hqMissingCta}"/>

            <TextBlock Margin="0,14,0,0" FontSize="10" Foreground="{StaticResource TextDimBrush}"
                       HorizontalAlignment="Center" Text="{DynamicResource hqMissingOnce}"/>

            <Button Content="{DynamicResource gotIt}" HorizontalAlignment="Right" Margin="0,10,0,0"
                    Click="Ok_Click" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="20,8"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="7"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</Window>
